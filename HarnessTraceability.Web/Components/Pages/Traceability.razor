@page "/traceability"
@inject TraceabilityDataService Data
@inject SessionState Session
<PageTitle>Harness traceability</PageTitle>
<MudText Typo="Typo.overline" Color="Color.Secondary">Search and investigate</MudText><MudText Typo="Typo.h4" Class="page-title mb-4">Harness traceability search</MudText><MudPaper Class="pa-5 mb-5 data-card filter-panel"><MudGrid><MudItem xs="12" md="3"><MudSelect T="string" @bind-Value="site" Label="Site" Variant="Variant.Outlined" Required="true">@foreach(var s in Session.Sites){<MudSelectItem Value="@s">@s</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="3"><MudRadioGroup @bind-Value="mode"><MudRadio Value="true" Color="Color.Primary">Final label</MudRadio><MudRadio Value="false" Color="Color.Primary">Travel ticket</MudRadio></MudRadioGroup></MudItem><MudItem xs="12" md="4"><MudTextField @bind-Value="label" Label="TT / Final label" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" md="2" Class="d-flex align-center"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Search" StartIcon="@Icons.Material.Filled.Search">Search</MudButton></MudItem></MudGrid></MudPaper>@if(!string.IsNullOrWhiteSpace(error)){<MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>}@if(busy){<MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />}@if(table is not null){<MudPaper Class="pa-5 data-card"><MudText Typo="Typo.h6" Class="mb-3">Search results</MudText><ResultTable Table="table" FileName="traceability-results.xlsx" /></MudPaper>}
@code { string site=""; string label=""; bool mode=true,busy; string? error; DataTable? table; protected override void OnInitialized(){site=Session.SelectedSite??Session.Sites.FirstOrDefault()??"";} async Task Search(){error=null;table=null;if(string.IsNullOrWhiteSpace(site)||string.IsNullOrWhiteSpace(label)){error="Select a site and enter a label.";return;}if(label.Trim().Length<=10&&mode){error="Please enter the full S/N. It must contain more than 10 characters.";return;}busy=true;try{table=await Data.SearchTraceabilityAsync(site,label.Trim(),mode);}catch(Exception ex){error=ex.Message;}finally{busy=false;}} }
