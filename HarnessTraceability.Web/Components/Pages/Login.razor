@page "/login"
@layout AuthLayout
@inject TraceabilityDataService Data
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>Sign in</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="pa-6"><MudPaper Elevation="4" Class="pa-8 data-card"><MudText Typo="Typo.h4" Color="Color.Primary">Harness Traceability</MudText><MudText Class="mb-6 muted">Sign in with your SEWS-E username to load your permitted sites.</MudText><MudForm @ref="form"><MudTextField @bind-Value="username" Label="Username" Variant="Variant.Outlined" Required="true" RequiredError="Username is required" /><MudButton Class="mt-5" FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Authenticate">@(busy ? "Authenticating…" : "Continue")</MudButton></MudForm>@if(!string.IsNullOrWhiteSpace(error)){<MudAlert Class="mt-4" Severity="Severity.Error">@error</MudAlert>}</MudPaper></MudContainer>
@code { MudForm? form; string username=""; string? error; bool busy; protected override void OnInitialized(){if(Session.IsAuthenticated)Nav.NavigateTo("/", replace:true);} async Task Authenticate(){await form!.Validate();if(!form.IsValid)return;busy=true;error=null;try{var result=await Data.AuthenticateAsync(username);if(!result.Success){error=result.Error;return;}Session.IsAuthenticated=true;Session.UserName=username;Session.Sites=result.Sites;Session.SelectedSite=result.Sites[0];Nav.NavigateTo("/", replace:true);}catch(Exception ex){error=ex.Message;}finally{busy=false;}} }
