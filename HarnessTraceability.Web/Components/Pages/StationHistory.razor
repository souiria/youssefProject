@page "/station-history"
@inject TraceabilityDataService Data
@inject SessionState Session
<PageTitle>Station production history</PageTitle><MudText Typo="Typo.h4" Class="mb-4">Station production history</MudText><MudPaper Class="pa-4 mb-5 data-card"><MudGrid><MudItem xs="12" md="3"><MudSelect T="string" @bind-Value="site" Label="Site" Variant="Variant.Outlined">@foreach(var s in Session.Sites){<MudSelectItem Value="@s">@s</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="host" Label="Hostname" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" md="3"><MudDatePicker @bind-Date="start" Label="Start date" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" md="3"><MudDatePicker @bind-Date="end" Label="End date" Variant="Variant.Outlined" /></MudItem><MudItem xs="12"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Search">Search</MudButton></MudItem></MudGrid></MudPaper>@if(!string.IsNullOrWhiteSpace(error)){<MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>}@if(busy){<MudProgressLinear Indeterminate="true" />}@if(table is not null){<MudPaper Class="pa-4 mt-4 data-card"><ResultTable Table="table" /></MudPaper>}
@code {string site="",host="";DateTime? start=DateTime.Today.AddDays(-1),end=DateTime.Today;bool busy;string? error;DataTable? table;protected override void OnInitialized(){site=Session.SelectedSite??Session.Sites.FirstOrDefault()??"";}async Task Search(){error=null;table=null;if(string.IsNullOrWhiteSpace(host)){error="Hostname is required.";return;}if(host.Trim().Length<4){error="Hostname is too short. Please enter a valid Hostname.";return;}if(start is null||end is null||start>=end){error="Start date must be earlier than end date.";return;}if((end-start)!.Value.TotalDays>365){error="Date range cannot exceed 365 days.";return;}busy=true;try{table=await Data.StatisticsAsync(site,host.Trim(),start.Value,end.Value);}catch(Exception ex){error=ex.Message;}finally{busy=false;}}}
