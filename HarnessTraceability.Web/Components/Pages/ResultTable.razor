@inject IJSRuntime JS
@if (Table is not null)
{
    <div class="result-toolbar"><MudText Typo="Typo.subtitle2" Class="muted">@Table.Rows.Count record(s)</MudText><MudSpacer /><MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.FileDownload" Disabled="@(Table.Rows.Count == 0)" OnClick="ExportExcel">Export Excel</MudButton></div>
    <MudTable Items="@Rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="460px" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>@foreach (var c in Columns) { <MudTh Class="result-header">@c</MudTh> }</HeaderContent>
        <RowTemplate Context="row">@foreach (var c in Columns) { <MudTd DataLabel="@c">@(row[c]?.ToString())</MudTd> }</RowTemplate>
        <NoRecordsContent><MudText Class="pa-4 muted">No records found.</MudText></NoRecordsContent>
    </MudTable>
}
@code {
    [Parameter] public DataTable? Table { get; set; }
    [Parameter] public string FileName { get; set; } = "harness-traceability-results.xlsx";
    private IEnumerable<DataRow> Rows => Table?.AsEnumerable() ?? Enumerable.Empty<DataRow>();
    private IEnumerable<string> Columns => Table?.Columns.Cast<DataColumn>().Select(c => c.ColumnName) ?? Enumerable.Empty<string>();
    private async Task ExportExcel()
    {
        if (Table is null || Table.Rows.Count == 0) return;
        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var sheet = workbook.Worksheets.Add("Results");
        for (var c = 0; c < Table.Columns.Count; c++)
        {
            var cell = sheet.Cell(1, c + 1); cell.Value = Table.Columns[c].ColumnName; cell.Style.Font.Bold = true; cell.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromHtml("#0F766E"); cell.Style.Font.FontColor = ClosedXML.Excel.XLColor.White;
        }
        for (var r = 0; r < Table.Rows.Count; r++) for (var c = 0; c < Table.Columns.Count; c++) sheet.Cell(r + 2, c + 1).Value = Table.Rows[r][c]?.ToString() ?? string.Empty;
        sheet.SheetView.FreezeRows(1); sheet.Columns().AdjustToContents();
        using var stream = new MemoryStream(); workbook.SaveAs(stream);
        await JS.InvokeVoidAsync("downloadFile", FileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(stream.ToArray()));
    }
}
