@page "/harness-details"
@inject TraceabilityDataService Data
@inject SessionState Session
<PageTitle>Harness details</PageTitle><MudText Typo="Typo.h4" Class="mb-4">Harness details</MudText><MudPaper Class="pa-4 mb-5 data-card"><MudGrid><MudItem xs="12" md="4"><MudTextField @bind-Value="harness" Label="Travel ticket / harness ID" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" md="4"><MudTextField @bind-Value="host" Label="Hostname" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" md="4" Class="d-flex align-center"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Load details</MudButton></MudItem></MudGrid></MudPaper>@if(!string.IsNullOrWhiteSpace(error)){<MudAlert Severity="Severity.Error">@error</MudAlert>}@if(table is not null){<MudPaper Class="pa-4 data-card"><ResultTable Table="table" /></MudPaper>}
@code {string harness="",host="";string? error;DataTable? table;async Task Load(){error=null;table=null;if(string.IsNullOrWhiteSpace(Session.SelectedSite)||string.IsNullOrWhiteSpace(harness)||string.IsNullOrWhiteSpace(host)){error="Site, harness ID, and hostname are required.";return;}try{table=await Data.HarnessDetailsAsync(Session.SelectedSite,harness.Trim(),host.Trim());if(table.Rows.Count==0)error="There are no synchronized details for this harness.";}catch(Exception ex){error=ex.Message;}}}
