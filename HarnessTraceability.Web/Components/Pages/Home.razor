@page "/"
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>Dashboard</PageTitle>
@if(!Session.IsAuthenticated){<MudAlert Severity="Severity.Info">Please sign in to use the application.</MudAlert><MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Sign in</MudButton>}else{<MudText Typo="Typo.overline" Color="Color.Secondary">Operations workspace</MudText><MudText Typo="Typo.h3" Class="page-title mb-5">Good to see you, @Session.UserName</MudText><MudPaper Class="hero pa-8 mb-7"><MudText Typo="Typo.h4">Harness Traceability</MudText><MudText Typo="Typo.subtitle1" Class="mt-2">Search production history, investigate defects, and export results for analysis.</MudText><MudChipSet T="string" Class="mt-5"><MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@Session.Sites.Count site(s) available</MudChip></MudChipSet></MudPaper><MudText Typo="Typo.h6" Class="mb-4">Choose a workflow</MudText><MudGrid><MudItem xs="12" md="4"><MudCard Class="data-card"><MudCardContent><MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">Traceability search</MudText><MudText Class="muted">Retrieve complete harness test history by final label or travel ticket.</MudText></MudCardContent><MudCardActions><MudButton Href="/traceability" Color="Color.Primary">Open workflow</MudButton></MudCardActions></MudCard></MudItem><MudItem xs="12" md="4"><MudCard Class="data-card"><MudCardContent><MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Secondary" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">Station production history</MudText><MudText Class="muted">Review station output across a selected date range.</MudText></MudCardContent><MudCardActions><MudButton Href="/station-history" Color="Color.Primary">Open workflow</MudButton></MudCardActions></MudCard></MudItem><MudItem xs="12" md="4"><MudCard Class="data-card"><MudCardContent><MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">Defected harnesses</MudText><MudText Class="muted">Find defective harness serial numbers for quality investigation.</MudText></MudCardContent><MudCardActions><MudButton Href="/defected-harnesses" Color="Color.Primary">Open workflow</MudButton></MudCardActions></MudCard></MudItem></MudGrid>}
