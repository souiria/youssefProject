@page "/"
@inject SessionState Session
@inject NavigationManager Nav
<PageTitle>Dashboard</PageTitle>
@if(!Session.IsAuthenticated){<MudAlert Severity="Severity.Info">Please sign in to use the application.</MudAlert><MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Sign in</MudButton>}else{<MudPaper Class="hero pa-8 mb-6 data-card"><MudText Typo="Typo.h3">Harness Traceability</MudText><MudText Typo="Typo.subtitle1">Connected as @Session.UserName</MudText></MudPaper><MudGrid><MudItem xs="12" md="4"><MudCard Class="data-card"><MudCardContent><MudText Typo="Typo.h6">Traceability search</MudText><MudText Class="muted">Retrieve complete harness test history.</MudText></MudCardContent><MudCardActions><MudButton Href="/traceability" Color="Color.Primary">Open</MudButton></MudCardActions></MudCard></MudItem><MudItem xs="12" md="4"><MudCard Class="data-card"><MudCardContent><MudText Typo="Typo.h6">Station production history</MudText><MudText Class="muted">Review station output over a date range.</MudText></MudCardContent><MudCardActions><MudButton Href="/station-history" Color="Color.Primary">Open</MudButton></MudCardActions></MudCard></MudItem><MudItem xs="12" md="4"><MudCard Class="data-card"><MudCardContent><MudText Typo="Typo.h6">Defected harnesses</MudText><MudText Class="muted">Find defective harness serial numbers.</MudText></MudCardContent><MudCardActions><MudButton Href="/defected-harnesses" Color="Color.Primary">Open</MudButton></MudCardActions></MudCard></MudItem></MudGrid>}
