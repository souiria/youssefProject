@page "/hostname-lookup"
@inject TraceabilityDataService Data
@inject SessionState Session
<PageTitle>Hostname lookup</PageTitle><MudText Typo="Typo.h4" Class="mb-4">Hostname lookup</MudText><MudPaper Class="pa-4 mb-5 data-card"><MudGrid><MudItem xs="12" md="3"><MudSelect T="string" @bind-Value="site" Label="Site" Variant="Variant.Outlined">@foreach(var s in Session.Sites){<MudSelectItem Value="@s">@s</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="3"><MudSelect T="string" @bind-Value="mode" Label="Search by" Variant="Variant.Outlined"><MudSelectItem Value="@("out")">Harness S/N</MudSelectItem><MudSelectItem Value="@("ref")">Reference</MudSelectItem><MudSelectItem Value="@("tt")">Travel ticket</MudSelectItem></MudSelect></MudItem><MudItem xs="12" md="4"><MudTextField @bind-Value="value" Label="Value" Variant="Variant.Outlined" /></MudItem><MudItem xs="12" md="2" Class="d-flex align-center"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="Search">Search</MudButton></MudItem></MudGrid></MudPaper>@if(!string.IsNullOrWhiteSpace(error)){<MudAlert Severity="Severity.Error">@error</MudAlert>}@if(table is not null){<MudPaper Class="pa-4 mt-4 data-card"><ResultTable Table="table" /></MudPaper>}
@code {string site="",mode="out",value="";string? error;DataTable? table;protected override void OnInitialized(){site=Session.SelectedSite??Session.Sites.FirstOrDefault()??"";}async Task Search(){error=null;table=null;if(string.IsNullOrWhiteSpace(value)){error="Enter a search value.";return;}try{var server=Data.ServerFor(site);if(server is null){error="Unknown site.";return;} // Reuse the traceability query for the final-label path; other paths can be enabled with the same existing view methods.
table=await Data.SearchTraceabilityAsync(site,value.Trim(),mode=="out");}catch(Exception ex){error=ex.Message;}}}
